# Copy to .env at the repository root. Never commit real credentials.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://showroom:CHANGE_ME@localhost:5432/showroom?schema=public
# docker compose reads these values. Use a unique password.
POSTGRES_USER=showroom
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=showroom
# One-time owner provisioning; remove password after running db:owner.
OWNER_EMAIL=
OWNER_PASSWORD=
# Server-only Cloudinary credentials; never prefix with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_MAX_BYTES=5242880
PRODUCT_MAX_IMAGES=10
# SMTP is required before enabling password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Production: true behind a trusted reverse proxy, with HTTPS.
TRUST_PROXY=false

# Virtual jewellery try-on. Defaults apply until the owner saves settings.
TRYON_PHOTO_ENABLED=false
TRYON_AR_ENABLED=false
TRYON_MAX_UPLOAD_MB=10
TRYON_RESULT_RETENTION_HOURS=24
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
# Optional absolute path on a private local volume, outside any web-served or synced folder.
TRYON_PRIVATE_DIR=
